# === Godot 4 导入缓存 / 构建产物（绝不提交）===
.godot/
.import/
*.tmp
.mono/
data_*/
mono_crash.*.json

# === 打包与运行期产物 ===
dist/
build/
*.pck
*.exe
*.zip
# 帧缓存（默认落在 exe 同级 fx_cache/，跑一次就有几十 MB）
fx_cache/
# 编辑器自动保存的备份工程（examples/demo/示范工程/示范工程_2026*.fxgraph）
examples/demo/*/*_20*.fxgraph

# === 系统 / 编辑器 ===
.DS_Store
**/.DS_Store
Thumbs.db
desktop.ini
*.swp
.vscode/
.idea/
__pycache__/
*.pyc

# === 日志 ===
*.log

# === 回归结论快照（tools/run_tests.sh 生成，check_docs.py 读它核对断言数）===
tools/.last_tests.json

# === 原生像素内核（插件 pixels.native 自带的 GDExtension）===
# 库、`.gdextension` 描述、绑定生成物、对象文件全是构建产物：
# godot-cpp 静态库输出
build/
# 没有 DLL 时引擎每次启动都会刷「dynamic library not found」，所以描述文件
# 也跟着产物走（模板见 plugins/pixels.native/pixels_native.gdextension.in）。
plugins/pixels.native/native/
plugins/pixels.native/build/
plugins/pixels.native/pixels_native.gdextension
plugins/pixels.native/.sconsign.dblite
# 历史位置（扩展曾是仓库级而不是插件级的），留着是为了让旧工作区不被误提交
extensions/pixel_native/bin/
extensions/pixel_native/fx_pixel_native.gdextension
extensions/pixel_native/.sconsign.dblite
extensions/**/*.obj
extensions/**/*.import

# === 调色抠像原生包（插件 fx.native-kit）===
# 与 pixels.native 同一条规矩：DLL / .exp / .lib / 生成的头文件都不入库。
# 例外是**没有回落**——这套算子只有 C++ 实现，克隆后不编就没有这些节点，
# 所以 README 的「怎么跑起来」里必须给出 build.sh 那一步。
plugins/fx.native-kit/native/
plugins/fx.native-kit/build/
plugins/fx.native-kit/fx_native_kit.gdextension
