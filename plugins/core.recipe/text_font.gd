## 大写化 + 未知字符回空格：字模表之外的输入不会让渲染崩。
static func normalize_char(ch: String) -> String:
	var upper: String = ch.to_upper()
	return ch if GLYPHS.has(ch) else (upper if GLYPHS.has(upper) else " ")


## 某字符的字模位图（7 个 5bit 行）。未知字符返回空格字模。
static func glyph(ch: String) -> Array:
	return GLYPHS.get(normalize_char(ch), GLYPHS[" "]) as Array


## 该字符字模在 (col,row) 处是否有点。
static func has_pixel(ch: String, col: int, row: int) -> bool:
	if col < 0 or col >= GLYPH_W or row < 0 or row >= GLYPH_H:
		return false
	var rows: Array = glyph(ch)
	if row >= rows.size():
		return false
	return int(rows[row]) & (1 << (GLYPH_W - 1 - col)) != 0


## 整串的像素宽度（含 1px 字距；文字层排版用）。
static func measure(text: String) -> int:
	return maxi(0, text.length() * (GLYPH_W + 1) - 1)
