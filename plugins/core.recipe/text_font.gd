	",": [0, 0, 0, 0, 12, 4, 8],
	":": [0, 12, 12, 0, 12, 12, 0],
	"-": [0, 0, 0, 31, 0, 0, 0],
	"+": [0, 4, 4, 31, 4, 4, 0],
	"/": [1, 1, 2, 4, 8, 16, 16],
	"'": [4, 4, 0, 0, 0, 0, 0],
	"(": [2, 4, 8, 8, 8, 4, 2],
