class_name TextFont
extends RefCounted
## 内嵌 5x7 像素字模：文字层的唯一字体来源。
##
## 为什么不用系统字体：这是**像素特效**工作台 —— 5x7 硬边字模与画布风格天然一致，
## 纯 Core 数据无外部依赖（无头/导出/换机器渲染结果完全一致），也躲开
## 系统字体加载、抗锯齿、授权这一整类问题。缺的字符自动落到空格。
##
## 数据格式：每个字符 7 个整数，第 n 个整数的 bit4..bit0 = 第 n 行的 5 个像素
## （bit4 = 最左）。查询接口 has_pixel() 是 O(1) 的纯函数。

const GLYPH_W: int = 5
const GLYPH_H: int = 7

const GLYPHS: Dictionary = {
