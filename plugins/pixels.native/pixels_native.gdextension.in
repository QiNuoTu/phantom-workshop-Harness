; 原生像素内核（插件 pixels.native 的一部分）。
;
; 加载与否都不影响画面：GDScript 侧（core.pixels/fx_native_bridge.gd）先查
; ClassDB 里有没有这五个类，没有就退回纯 GDScript 实现。
; 所以这个文件在、库没编出来时，工程仍然能跑（只是慢一些）—— 这是「插件可缺席」
; 的前提，也是删掉整个目录后仍能启动的原因。
;
; 库路径必须与 SConstruct 生成的 `native/<name><suffix>.dll` 逐字一致。

[configuration]

entry_symbol = "pixels_native_library_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]

windows.debug.x86_64 = "res://plugins/pixels.native/native/pixels_native.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://plugins/pixels.native/native/pixels_native.windows.template_release.x86_64.dll"
