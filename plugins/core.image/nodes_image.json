{
	"category": "图像/处理",
	"nodes": [
		{
			"id": "image.blur",
			"label": "模糊",
			"desc": "可分离盒式模糊。半径打关键帧就是逐步虚化。",
			"op": "image.blur",
			"inputs": [
				{"id": "image", "label": "图像", "type": "image", "required": true}
			],
			"outputs": [
				{"id": "image", "label": "图像", "type": "image"}
			],
			"params": [
				{"id": "radius", "label": "半径", "kind": "int", "default": 2, "min": 0, "max": 32, "step": 1, "unit": "px", "bindable": true}
			]
		},
		{
			"id": "image.levels",
			"label": "色阶",
			"desc": "亮度、对比度、伽马。像素特效里最常用的“提亮高光、压暗底”。",
			"op": "image.levels",
			"inputs": [
				{"id": "image", "label": "图像", "type": "image", "required": true}
			],
			"outputs": [
				{"id": "image", "label": "图像", "type": "image"}
			],
			"params": [
				{"id": "brightness", "label": "亮度", "kind": "float", "default": 0.0, "min": -1.0, "max": 1.0, "step": 0.01, "bindable": true},
				{"id": "contrast", "label": "对比度", "kind": "float", "default": 1.0, "min": 0.0, "max": 4.0, "step": 0.01, "bindable": true},
				{"id": "gamma", "label": "伽马", "kind": "float", "default": 1.0, "min": 0.1, "max": 4.0, "step": 0.01, "bindable": true}
			]
		},
		{
			"id": "image.tint",
			"label": "染色",
			"desc": "按颜色调制画面。勾选保持亮度时只改色相与饱和度。",
			"op": "image.tint",
			"inputs": [
				{"id": "image", "label": "图像", "type": "image", "required": true}
			],
			"outputs": [
				{"id": "image", "label": "图像", "type": "image"}
			],
			"params": [
				{"id": "color", "label": "颜色", "kind": "color", "default": "#ff7a2a", "bindable": true},
				{"id": "amount", "label": "强度", "kind": "float", "default": 1.0, "min": 0.0, "max": 1.0, "step": 0.01, "bindable": true},
				{"id": "preserve_luma", "label": "保持亮度", "kind": "bool", "default": false}
			]
		},
		{
			"id": "image.transform",
			"label": "变换",
			"desc": "位移 / 缩放 / 旋转 / 轴心。参数绑定循环索引就能做阵列。",
			"op": "image.transform",
			"inputs": [
				{"id": "image", "label": "图像", "type": "image", "required": true}
			],
			"outputs": [
				{"id": "image", "label": "图像", "type": "image"}
			],
			"params": [
				{"id": "offset", "label": "位移", "kind": "vec2", "default": [0, 0], "min": -2048, "max": 2048, "step": 1, "unit": "px", "bindable": true},
				{"id": "scale", "label": "缩放", "kind": "vec2", "default": [1, 1], "min": -16, "max": 16, "step": 0.01, "unit": "×", "bindable": true},
				{"id": "rotation", "label": "旋转", "kind": "float", "default": 0.0, "min": -360, "max": 360, "step": 0.5, "unit": "°", "bindable": true},
				{"id": "anchor", "label": "轴心", "kind": "vec2", "default": [0.5, 0.5], "min": 0, "max": 1, "step": 0.01},
				{"id": "wrap", "label": "边缘", "kind": "enum", "default": "transparent", "options": ["transparent", "clamp", "repeat"]}
			]
		},
		{
			"id": "image.mix",
			"label": "混合",
			"desc": "把 B 叠到 A 上。混合模式与输出图层共用同一套实现。",
			"op": "image.mix",
			"inputs": [
				{"id": "a", "label": "A 底", "type": "image"},
				{"id": "b", "label": "B 顶", "type": "image"}
			],
			"outputs": [
				{"id": "image", "label": "图像", "type": "image"}
			],
			"params": [
				{"id": "mode", "label": "模式", "kind": "enum", "default": "normal", "options": ["normal", "add", "multiply", "screen", "overlay", "subtract"]},
				{"id": "amount", "label": "不透明度", "kind": "float", "default": 1.0, "min": 0.0, "max": 1.0, "step": 0.01, "bindable": true}
			]
		},
		{
			"id": "image.threshold",
			"label": "阈值",
			"desc": "把 alpha 或亮度切成硬边遮罩。软边用 softness 控制。",
			"op": "image.threshold",
			"inputs": [
				{"id": "image", "label": "图像", "type": "image", "required": true}
			],
			"outputs": [
				{"id": "image", "label": "图像", "type": "image"}
			],
			"params": [
				{"id": "channel", "label": "通道", "kind": "enum", "default": "alpha", "options": ["alpha", "luma"]},
				{"id": "cutoff", "label": "阈值", "kind": "float", "default": 0.5, "min": 0.0, "max": 1.0, "step": 0.01, "bindable": true},
				{"id": "softness", "label": "软边", "kind": "float", "default": 0.02, "min": 0.0, "max": 0.5, "step": 0.005, "bindable": true},
				{"id": "color", "label": "颜色", "kind": "color", "default": "#ffffff", "bindable": true}
			]
		},
		{
			"id": "image.invert",
			"label": "反相",
			"desc": "RGB 取反，alpha 保持不变。",
			"op": "image.invert",
			"inputs": [
				{"id": "image", "label": "图像", "type": "image", "required": true}
			],
			"outputs": [
				{"id": "image", "label": "图像", "type": "image"}
			],
			"params": []
		}
	]
}
